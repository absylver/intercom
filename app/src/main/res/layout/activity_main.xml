<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/mark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/mark"
                android:gravity="center"
                android:text="LO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not connected"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Join panel -->
        <LinearLayout
            android:id="@+id/join_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Label"
                android:text="CAMERA NAME" />

            <EditText
                android:id="@+id/cam_name"
                style="@style/Field"
                android:hint="e.g. Camera 1 — Wide"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Label"
                android:text="POSITION (OPTIONAL)" />

            <EditText
                android:id="@+id/cam_pos"
                style="@style/Field"
                android:hint="e.g. Stage left"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Label"
                android:text="CONTROL ROOM" />

            <TextView
                android:id="@+id/found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Searching the WiFi for the control laptop…"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/manual_host"
                style="@style/Field"
                android:hint="Or type the laptop address, e.g. 192.168.1.50"
                android:inputType="textUri" />

            <Button
                android:id="@+id/join"
                style="@style/BigButton"
                android:layout_marginTop="18dp"
                android:text="JOIN INTERCOM" />

            <TextView
                style="@style/Note"
                android:text="Plug in your earphones first. The laptop must be running OronIntercom.exe on the same WiFi." />
        </LinearLayout>

        <!-- Live panel -->
        <LinearLayout
            android:id="@+id/live_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/incoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pill"
                android:gravity="center"
                android:padding="12dp"
                android:text="STANDBY"
                android:textColor="@color/muted"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <Button
                android:id="@+id/ptt"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="26dp"
                android:background="@drawable/ptt"
                android:text="HOLD TO\nTALK"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dir_state"
                    style="@style/Stat"
                    android:layout_marginEnd="6dp"
                    android:text="DIRECTOR\nOffline" />

                <TextView
                    android:id="@+id/voice_state"
                    style="@style/Stat"
                    android:layout_marginStart="6dp"
                    android:text="VOICE\n—" />
            </LinearLayout>

            <TextView
                style="@style/Note"
                android:text="You can lock the phone and put it in your pocket. Earphone button: quick press to start or stop talking, or hold it while you speak." />

            <TextView
                android:id="@+id/battery"
                style="@style/Note"
                android:text="Phone stops the intercom when locked? Tap here to let it run in the background."
                android:textColor="@color/warn"
                android:visibility="gone" />

            <Button
                android:id="@+id/leave"
                style="@style/GhostButton"
                android:layout_marginTop="16dp"
                android:text="LEAVE INTERCOM" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
