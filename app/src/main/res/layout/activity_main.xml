<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/content"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- Header: gradient strip, round gradient badge, name + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/mark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/mark"
                android:gravity="center"
                android:text="LO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.04"
                    android:text="Not connected"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Join panel -->
        <LinearLayout
            android:id="@+id/join_panel"
            style="@style/Card"
            android:layout_marginTop="@dimen/gap"
            android:padding="@dimen/card_pad">

            <TextView
                style="@style/Label"
                android:layout_marginTop="0dp"
                android:text="JOIN THE INTERCOM"
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <TextView
                style="@style/Label"
                android:text="CAMERA NAME" />

            <EditText
                android:id="@+id/cam_name"
                style="@style/Field"
                android:hint="e.g. Camera 1 — Wide"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Label"
                android:text="POSITION (OPTIONAL)" />

            <EditText
                android:id="@+id/cam_pos"
                style="@style/Field"
                android:hint="e.g. Stage left"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Label"
                android:text="CONTROL ROOM" />

            <TextView
                android:id="@+id/found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field"
                android:padding="16dp"
                android:text="Searching the WiFi for the control laptop…"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/manual_host"
                style="@style/Field"
                android:layout_marginTop="10dp"
                android:hint="Or type the laptop address"
                android:inputType="textUri" />

            <Button
                android:id="@+id/join"
                style="@style/BigButton"
                android:layout_marginTop="20dp"
                android:text="JOIN INTERCOM" />

            <TextView
                style="@style/Note"
                android:text="Plug in your earphones first. The control laptop must be running Oron Intercom on the same WiFi." />
        </LinearLayout>

        <!-- Live panel -->
        <LinearLayout
            android:id="@+id/live_panel"
            style="@style/Card"
            android:layout_marginTop="@dimen/gap"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:padding="@dimen/card_pad"
            android:visibility="gone">

            <TextView
                android:id="@+id/incoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pill"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:padding="13dp"
                android:text="STANDBY"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="@dimen/ptt_box"
                android:layout_height="@dimen/ptt_box"
                android:layout_marginTop="8dp"
                android:clipChildren="false">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ptt_glow" />

                <Button
                    android:id="@+id/ptt"
                    android:layout_width="@dimen/ptt"
                    android:layout_height="@dimen/ptt"
                    android:layout_gravity="center"
                    android:background="@drawable/ptt"
                    android:elevation="16dp"
                    android:stateListAnimator="@null"
                    android:letterSpacing="0.06"
                    android:text="HOLD TO\nTALK"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dir_state"
                    style="@style/Stat"
                    android:layout_marginEnd="@dimen/half_gap"
                    android:text="Offline" />

                <TextView
                    android:id="@+id/voice_state"
                    style="@style/Stat"
                    android:layout_marginStart="@dimen/half_gap"
                    android:text="—" />
            </LinearLayout>

            <TextView
                style="@style/Note"
                android:text="Lock the phone and put it in your pocket. Earphone button: quick press to start or stop talking, or hold it while you speak." />

            <TextView
                android:id="@+id/battery"
                style="@style/Note"
                android:text="Phone stops the intercom when locked? Tap here to let it run in the background."
                android:textColor="@color/warn"
                android:visibility="gone" />

            <Button
                android:id="@+id/leave"
                style="@style/GhostButton"
                android:layout_marginTop="20dp"
                android:text="LEAVE INTERCOM" />
        </LinearLayout>

        <!-- Camera card: this phone as a wireless camera for OBS / vMix -->
        <LinearLayout
            android:id="@+id/camera_panel"
            style="@style/Card"
            android:layout_marginTop="@dimen/gap"
            android:padding="@dimen/card_pad"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="CAMERA"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/cam_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill"
                    android:letterSpacing="0.18"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="OFF"
                    android:textColor="@color/muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/preview_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/field"
                android:visibility="gone">

                <org.webrtc.SurfaceViewRenderer
                    android:id="@+id/preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                style="@style/Label"
                android:text="CAMERA SLOT ON THE LAPTOP" />

            <LinearLayout
                android:id="@+id/slot_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/Label"
                android:text="QUALITY" />

            <LinearLayout
                android:id="@+id/quality_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/Label"
                android:text="FRAME RATE" />

            <LinearLayout
                android:id="@+id/fps_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cam_flip"
                    style="@style/GhostButton"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/half_gap"
                    android:layout_weight="1"
                    android:text="BACK LENS" />

                <Button
                    android:id="@+id/cam_toggle"
                    style="@style/BigButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/half_gap"
                    android:layout_weight="1.4"
                    android:text="START CAMERA" />
            </LinearLayout>

            <TextView
                android:id="@+id/cam_status"
                style="@style/Note"
                android:text="Mount the phone, pick its slot, then start. In OBS or vMix choose the matching “Oron Camera”." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
